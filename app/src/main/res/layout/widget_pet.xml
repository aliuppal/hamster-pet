<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="12dp">

    <ImageView
        android:id="@+id/pet_image"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="@string/widget_pet_desc"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_launcher_foreground" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/pet_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Peanut"
            android:textColor="#3B2618"
            android:textSize="15sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/pet_mood"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Happy"
            android:textColor="#7A5A3F"
            android:textSize="12sp" />
    </LinearLayout>
    <ProgressBar
        android:id="@+id/bar_food"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="4dp"
        android:max="100"
        android:progressTint="#E8A33D"
        android:progressBackgroundTint="#F1E2D4" />
    <ProgressBar
        android:id="@+id/bar_happy"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="4dp"
        android:max="100"
        android:progressTint="#E8707A"
        android:progressBackgroundTint="#F1E2D4" />
    <ProgressBar
        android:id="@+id/bar_energy"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="4dp"
        android:max="100"
        android:progressTint="#5BAE6A"
        android:progressBackgroundTint="#F1E2D4" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/btn_feed"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginStart="0dp"
            android:background="@drawable/widget_btn"
            android:gravity="center"
            android:text="Feed"
            android:textColor="#3B1E08"
            android:textSize="12sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/btn_play"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_btn"
            android:gravity="center"
            android:text="Play"
            android:textColor="#3B1E08"
            android:textSize="12sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/btn_chat"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_btn"
            android:gravity="center"
            android:text="Chat"
            android:textColor="#3B1E08"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
